// Application icon: Explorer, taskbar, Alt+Tab and the executable's shell
// icon. The PNG/ICO files under assets/ are build-time inputs only; the Qt UI
// paints its own copy with QPainter (see Logo.cpp).
IDI_APP_ICON ICON "assets/logo.ico"

1 VERSIONINFO
FILEVERSION 0,1,1,0
PRODUCTVERSION 0,1,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Hmmob"
            VALUE "FileDescription", "Hmmob EV Screen Recorder"
            VALUE "FileVersion", "0.1.1"
            VALUE "ProductName", "Hmmob EV"
            VALUE "ProductVersion", "0.1.1"
            VALUE "LegalCopyright", "Copyright (c) 2026 Hmmob"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
